    FROM [AdminUsers] AS [a]
    WHERE [a].[Id] = @request_AdminUserId
) AS [a1]
LEFT JOIN (
    SELECT [a0].[Id], [a0].[AdminUserId], [a0].[CreatedAtUtc], [a0].[PermissionId], [a0].[UpdatedAtUtc], [p].[Id] AS [Id0], [p].[CreatedAtUtc] AS [CreatedAtUtc0], [p].[Description], [p].[Group], [p].[Name], [p].[UpdatedAtUtc] AS [UpdatedAtUtc0]
