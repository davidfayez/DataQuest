    SELECT TOP(1) [a].[Id], [a].[AvatarStoragePath], [a].[CreatedAtUtc], [a].[Email], [a].[FailedLoginAttempts], [a].[FullName], [a].[IsActive], [a].[LanguageCode], [a].[LastLoginAtUtc], [a].[LockoutEndsAtUtc], [a].[PasswordHash], [a].[PasswordResetTokenExpiresAtUtc], [a].[PasswordResetTokenHash], [a].[UpdatedAtUtc], [a].[Username]
    FROM [AdminUsers] AS [a]
    WHERE [a].[Email] = @identifier OR [a].[Username] = @normalized
) AS [a1]
LEFT JOIN (
    SELECT [a0].[Id], [a0].[AdminUserId], [a0].[CreatedAtUtc], [a0].[PermissionId], [a0].[UpdatedAtUtc], [p].[Id] AS [Id0], [p].[CreatedAtUtc] AS [CreatedAtUtc0], [p].[Description], [p].[Group], [p].[Name], [p].[UpdatedAtUtc] AS [UpdatedAtUtc0]
    FROM [AdminUserPermissions] AS [a0]
    INNER JOIN [Permissions] AS [p] ON [a0].[PermissionId] = [p].[Id]
) AS [s] ON [a1].[Id] = [s].[AdminUserId]
ORDER BY [a1].[Id], [s].[Id]
