<?xml version="1.0" encoding="utf-8"?>
<!--
    Kept in source rather than left to the SDK's generated default, because the default does not
    survive contact with a stock IIS install: the WebDAV module ships enabled, claims PUT and
    DELETE before handler selection, and answers them with its own 405 page. That page carries no
    CORS headers, so a browser reports it as a network failure rather than a 405 — which is how a
    blocked "edit application" (PUT /applications/{id}) or "set up order" (PUT /orders/setup)
    reached applicants as "Check your connection and try again".

    Removing the module and its handler hands every verb back to AspNetCoreModuleV2. Both removes
    are no-ops on a server where WebDAV was never installed, so this is safe everywhere.

    The publish target rewrites the aspNetCore element below (process path, arguments, hosting
    model) but leaves the rest of the file alone.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <modules>
        <remove name="WebDAVModule" />
      </modules>
      <handlers>
        <remove name="WebDAV" />
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\DataVerification.API.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
    </system.webServer>
  </location>
</configuration>
