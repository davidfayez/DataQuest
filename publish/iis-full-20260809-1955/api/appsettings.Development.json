{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    }
  },
  "Smtp": {
    "Enabled": false
  },
  "App": {
    "EchoCredentialsInResponse": true
  },
  "Wallet": {
    "AllowSimulatedDeposits": true
  }
}
