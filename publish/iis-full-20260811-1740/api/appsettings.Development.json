{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    }
  },
  "Smtp": {
    "Enabled": false
  },
  // Development delivers no real mail: the sender writes the whole message to the console instead,
  // which is where the generated order number and password are read from. Without this the API
  // would dial SendGrid for every registration and the credentials would go nowhere.
  "SendGrid": {
    "Enabled": false
  },
  "App": {
    "EchoCredentialsInResponse": true
  },
  "Wallet": {
    "AllowSimulatedDeposits": true
  }
}
