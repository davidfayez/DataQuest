<?xml version="1.0" encoding="utf-8"?>
<!--
    TEMPLATE — for the API site only: E:\inetpub\DataVerification\api\web.config

    This file is deliberately NOT in the api\ folder of this bundle. Every value the API needs to
    reach the right database, sign tokens and send email lives in <environmentVariables> below, and
    a copy shipped inside api\ would overwrite yours on the next deploy.

    ONLY use this whole file if the server has no web.config at all. If one is already there, keep
    it and add the pieces you are missing — starting with the WebDAV removal below.

    The double underscore __ is the .NET separator for nested keys: Jwt__SigningKey overrides
    Jwt:SigningKey in appsettings.json.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>

      <!--
        REQUIRED. IIS installs a WebDAV module and handler that claim PUT and DELETE before
        ASP.NET Core ever sees them, answering 405 Method Not Allowed with
        "Allow: GET, HEAD, OPTIONS, TRACE". POST and GET keep working, so the site looks healthy
        while every PUT and DELETE fails — order setup, saving the SendGrid key, editing an
        application, replacing a country's currencies, and every delete in the admin panel.

        The browser receives no usable response, so the SPAs report it as a connection failure:
        "Check your connection and try again."

        Both lines are needed, and <remove name="WebDAV" /> must come before the aspNetCore
        handler.
      -->
      <handlers>
        <remove name="WebDAV" />
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>

      <modules runAllManagedModulesForAllRequests="false">
        <remove name="WebDAVModule" />
      </modules>

      <aspNetCore processPath=".\DataVerification.API.exe"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <environmentVariables>

          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />

          <!-- REQUIRED. appsettings.json is committed with a connection string pointing at
               172.201.83.229 / VData_Prod. This override decides which database is actually used. -->
          <environmentVariable name="ConnectionStrings__DefaultConnection"
                               value="Server=SQLHOST;Database=VData_Prod;User Id=dv_app;Password=REPLACE_ME;TrustServerCertificate=True;MultipleActiveResultSets=true" />

          <!-- REQUIRED. The API refuses to start if this is missing or under 32 characters.
               appsettings.json carries a PLACEHOLDER that is committed to the repository — leaving
               it in place means anyone who can read the repo can forge an admin token. -->
          <environmentVariable name="Jwt__SigningKey" value="REPLACE_WITH_A_32_PLUS_CHARACTER_SECRET" />

          <!-- REQUIRED for the Settings page and for revealing order passwords. 32 bytes base64.
               Generate:  $b = New-Object byte[] 32
                          [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b)
                          [Convert]::ToBase64String($b)
               BACK IT UP. Change it and everything encrypted under it becomes unreadable. -->
          <environmentVariable name="Security__EncryptionKey" value="REPLACE_WITH_32_BYTE_BASE64" />

          <!-- Absolute path, so uploads survive a redeploy. Left unset, files are written inside
               the site folder and the next /MIR deploy deletes them. -->
          <environmentVariable name="Storage__RootPath" value="E:\DataVerification\storage" />

          <!-- Every SPA origin, indexed from 0. A missing one makes every browser call fail CORS. -->
          <environmentVariable name="Cors__AllowedOrigins__0" value="https://vdata.nen-global.org" />
          <environmentVariable name="Cors__AllowedOrigins__1" value="https://vdataadmin.nen-global.org" />

          <!-- Used to build the links inside outgoing email. -->
          <environmentVariable name="App__WebUrl"   value="https://vdata.nen-global.org" />
          <environmentVariable name="App__AdminUrl" value="https://vdataadmin.nen-global.org" />

          <!-- Optional fallback only. The live key is normally set on the admin Settings page and
               stored encrypted in the database, which takes precedence over this. -->
          <!-- <environmentVariable name="SendGrid__ApiKey" value="" /> -->

        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
